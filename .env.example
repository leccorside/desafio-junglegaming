# Liga o MSW (REST e Socket.IO). Fica true também no build de demonstração.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST feitas pelo Axios.
VITE_API_URL=/api

# Endereço do Socket.IO interceptado pelo MSW.
VITE_SOCKET_URL=ws://localhost/socket

# Opcional: token pessoal do Figma, só para scripts/export-figma-assets.mjs.
FIGMA_TOKEN=
